<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Tutorial01B_WinUIClient.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Tutorial01B_WinUIClient"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="320" />
            <ColumnDefinition Width="7*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer
            Grid.Column="0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="0,0,8,0" Spacing="16">
                <StackPanel Spacing="6">
                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="音声解析" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="選択した音声を文字起こしし、確定発話を Tutorial01B へ送信する。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <TextBox
                    x:Name="EndpointTextBox"
                    Header="API endpoint"
                    Text="http://localhost:12670/api/orchestrator/execute" />
                <TextBox
                    x:Name="CallbackUrlTextBox"
                    Header="Callback URL"
                    IsReadOnly="True"
                    Text="http://127.0.0.1:1305/callback" />
                <TextBox
                    x:Name="SessionIdTextBox"
                    Header="Session ID"
                    IsReadOnly="True"
                    PlaceholderText="初回送信後に設定される" />
                <TextBox
                    x:Name="SpeechRegionTextBox"
                    Header="Speech region"
                    PlaceholderText="例: japaneast" />
                <PasswordBox
                    x:Name="SpeechKeyPasswordBox"
                    Header="Azure AI Speech key"
                    PasswordChar="●"
                    PlaceholderText="AZURE_SPEECH_KEY 環境変数からも設定可能" />

                <StackPanel Spacing="8">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="マイク" />
                    <Border
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Height="130"
                        Padding="8">
                        <ListView ItemsSource="{x:Bind MicrophoneDevices}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        Content="{Binding Name}"
                                        IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="スピーカー（loopback）" />
                    <Border
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Height="130"
                        Padding="8">
                        <ListView ItemsSource="{x:Bind SpeakerDevices}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        Content="{Binding Name}"
                                        IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Click="RefreshDevicesButton_Click" Content="デバイス更新" />
                    <Button
                        x:Name="StartButton"
                        Click="StartButton_Click"
                        Content="文字起こし開始"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        x:Name="StopButton"
                        Click="StopButton_Click"
                        Content="停止"
                        IsEnabled="False" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="認識中（ソース別）" />
                    <Border
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Height="110"
                        Padding="4">
                        <ListView ItemsSource="{x:Bind SourceTranscripts}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="4" Spacing="2">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding SourceLabel}" />
                                        <TextBlock
                                            Text="{Binding Text}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>

                <InfoBar
                    x:Name="StatusInfoBar"
                    IsOpen="True"
                    IsClosable="False"
                    Message="Callback listener を起動しています..."
                    Severity="Informational" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="送受信履歴" />
            <ListView
                x:Name="HistoryListView"
                Grid.Row="1"
                ItemsSource="{x:Bind HistoryItems}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="4,8" Spacing="4">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{Binding Title}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding Detail}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
