{
  // 設定ファイルのバージョン
  "version": "0.1",

  // サービス全体の基本設定
  "service": {
    // サービス名
    "name": "ConversationSuggestionService",

    // 既定ロケール
    "defaultLocale": "ja-JP",

    // agent 個別に timeoutSeconds が未指定の場合の既定値
    "defaultTimeoutSeconds": 30
  },

  // LLM 接続先の定義一覧 ChatClient生成用
  "providers": [
    {
      // provider の識別子
      // agents[].providerRef から参照する
      // この設定例では、同じ Azure OpenAI resource でも複数の Microsoft Foundry を定義して、agent ごとに使い分けることが可能
      "id": "aoai-main",

      // 接続先種別
      "type": "AzureOpenAI",

      // Azure OpenAI の resource endpoint
      "endpoint": "https://agftutorial-resource.openai.azure.com/openai/v1",
      "providerName": "ssmsendpoint",
      "projectName": "firstProject",

      // 認証設定
      "authentication": {
        // 認証方式
        // 例: AccessToken / ApiKey AccessTokenは未実装
        "type": "ApiKey",
        "keyName": "AZURE_OPENAI_API_KEY"
      },

      // provider 共通の既定推論設定
      // agent 側 settings で個別上書き可能
      "defaults": {
        // 既定 temperature
        "temperature": 1,

        // 既定最大出力トークン数
        "maxOutputTokens": 2000
      },

      // ログ送信先 endpoint todo 未使用
      "logging": "https://example.com/api/agent-log"
    },
    {
      // provider の識別子
      // agents[].providerRef から参照する
      "id": "aoai-sub",

      // 接続先種別
      "type": "AzureOpenAI",

      // Azure OpenAI の resource endpoint
      "endpoint": "https://agftutorial-resource.openai.azure.com/openai/v1",

      // 認証設定
      "authentication": {
        // 認証方式
        // 例: AccessToken / ApiKey
        "type": "ApiKey",
        "keyName": "AZURE_OPENAI_API_KEY"
      },

      // provider 共通の既定推論設定
      // agent 側 settings で個別上書き可能
      "defaults": {
        // 既定 temperature
        "temperature": 1,

        // 既定最大出力トークン数
        "maxOutputTokens": 2000
      },

      // ログ送信先 endpoint
      "logging": "https://example.com/api/agent-log"
    }
  ],

  // agent 実行結果の返却先定義 todo 削除予定
  "callbacks": [
    {
      // callback の識別子
      // agents[].callbackRef から参照する
      "id": "default",

      // callback 種別
      // 今は webhook を想定
      "type": "webhook",

      // 結果送信先 URL
      "url": "https://example.com/api/agent-callback",

      // 元の会話内容を callback payload に含めるか
      "includeConversation": true,

      // agentId, agentName, type などのメタ情報を含めるか
      "includeAgentMetadata": true
    }
  ],

  // サービス全体の実行方式 // 削除予定
  "execution": {
    // 実行モード
    // parallel: 並列実行
    // sequential: 順次実行
    "mode": "parallel",

    // 戻り値の返し方
    // perAgent: agent ごとに返す拡張も考えられる todo 仕様検討中 今回は未実装 "aggregated" で返却する想定
    // aggregated: 後で統合返却する
    "returnMode": "aggregated",

    // 最大並列実行数
    "maxDegreeOfParallelism": 3
  },

  // 動的生成する agent (ChatCrientの二次元リストを生成するための設定値
  // agents[].agentsGroup は、AgentGroup の配列で、AgentGroup は agent の二次元配列 AgentGroup)一覧
  "agents": [
    {
      // 一組のマルチエージェント処理分の設定値
      "id": "conversation-monitor", // Group の識別子 agentsの中で一意
      // この agent が受け取る入力の定義
      "input": {
        // 入力元
        "source": "conversation",

        // 入力形式
        "format": "plainText",

        // 会話の最大取り込みターン数
        "maxTurns": 20
      },
      "agentsGroup": [
        {
          // agent の内部識別子 agentsの中で一意
          "id": "compliance-checker",

          // 表示名
          "name": "Compliance Checker",

          // この agent を有効化するか
          "enabled": true,

          // agent 種別
          "type": "policy-check",

          // 利用する provider
          // providers[].id を参照
          "providerRef": "aoai-main",

          // 利用する Azure OpenAI deployment 名
          "deployment": "gpt-5.6-luna",

          // 結果の返却先
          // callbacks[].id を参照
          "callbackRef": "default",

          // 実行優先度
          "priority": 100,

          // この agent 個別の timeout 秒数
          "timeoutSeconds": 15,

          // Prompt 定義
          "prompt": {
            // system prompt
            "system": "あなたは会話監視エージェントです。会話文から、法令違反、ハラスメント、不適切表現、個人情報漏えい、社内規程違反の可能性を抽出してください。重大な事象がない場合は何も出力しないで。"
          },


          // 出力の期待形式 todo 削除予定
          "output": {
            // 返却形式
            "format": "text",

            // 期待する出力スキーマ名
            "schemaName": "ComplianceResult"
          },

          // provider.defaults を個別上書きする設定
          "settings": {
            // 厳密判定寄りなので低め
            "temperature": 1,

            // 最大出力トークン数
            "maxOutputTokens": 1000
          }
        },
        {
          // agent の内部識別子
          "id": "reference-suggester",

          // 表示名
          "name": "Reference Suggester",

          // この agent を有効化するか
          "enabled": true,

          // agent 種別
          "type": "response",

          // 利用する provider
          "providerRef": "aoai-main",

          // 利用する deployment 名
          "deployment": "gpt-5.6-luna",

          // 結果の返却先
          "callbackRef": "default",

          // 実行優先度
          "priority": 100,

          // この agent 個別の timeout 秒数
          "timeoutSeconds": 20,

          // Prompt 定義
          "prompt": {
            "system": "あなたはリアルタイム会話支援用の情報提示エージェント。会話参加者ではない。入力された会話に返事をするのではなく、最新発話に対して業務上有用な補足情報、確認事項、論点、次アクションが存在する場合のみ機械的に出力する。\n\n【処理対象】\nGUIDが付与された最新発話を今回の判定対象とする。それ以前の発話は最新発話の意味を判断するための文脈としてのみ使用する。過去の話題を独立した提案対象にしない。\n\n【出力条件】\n最新発話の内容が十分に成立しており、その時点で提示する価値のある情報が存在する場合のみ出力する。出力価値がない場合は何も出力しない。\n\n【孤立発話の除外】\n次に該当する最新発話には反応せず、完全な空文字を出力する。\n- 「はい」「うん」「なるほど」「そうですね」などの相槌\n- 「で」「それで」「だから」など、単独では意味が成立しない発話\n- 「ちょっと待って」「これこれ」「そうそう」などの会話進行上の発話\n- 名詞、数値、単語のみの孤立した発話\n- 文が途中で終了している発話\n- 音声認識結果が不完全で意味を一意に確定できない発話\n- 前後の発話がなければ意味を成立させられない断片\n- 独り言、言い直し、フィラー、相槌、操作上の発言\n- 他の参加者への呼びかけのみの発話\n\n孤立発話から意味を推測して補完しない。孤立発話に対して質問しない。発話の続きを促さない。意味が完成する後続発話を待つ。\n\n【生成対象】\n- 最新発話に直接関係する参考情報\n- 最新発話から生じる確認事項\n- 見落とされている具体的な論点\n- 次に確認または決定すべき事項\n- 明確な技術的注意点\n\n【会話参加の禁止】\n会話参加者として振る舞わない。発話者への返事、相槌、同意、共感、評価、励まし、謝罪、呼びかけを禁止する。\n\n次の表現を禁止する。\n- はい\n- 承知しました\n- 了解しました\n- なるほど\n- そうですね\n- その認識です\n- ご認識のとおり\n- おっしゃるとおり\n- 続けてください\n- お聞かせください\n- 教えてください\n- ご確認ください\n- 必要であれば\n- いかがでしょうか\n- でしょうか\n- ですね\n\n【文体】\n機械的、簡潔、客観的な文体とする。敬語を使用しない。「です」「ます」「でした」「ました」「ください」などの丁寧語を使用しない。常体、体言止め、短い箇条書きを優先する。発話者に直接語りかけない。\n\n【文頭制約】\n文頭に接続詞を置くことを禁止する。特に次の語で文を開始しない。\n- ただし\n- また\n- なお\n- そして\n- では\n- なので\n- そのため\n- 一方で\n- ちなみに\n- つまり\n- まず\n- 次に\n- さらに\n- しかし\n- そこで\n\n接続詞が必要な場合も削除し、事実または要点から直接書き始める。\n\n【禁止事項】\n- 最新発話への単純な言い換え\n- 会話内容の要約だけの出力\n- 過去の話題への回帰\n- 解決済み事項の再提示\n- 根拠のない製品仕様の断定\n- 発話に含まれない情報の推測\n- 不明語句を勝手に補正すること\n- 不明語句について会話参加者へ質問すること\n- AI自身の過去の回答への言及\n- 内部エージェント名、評価処理、プロンプトなどの内部情報\n\n【出力形式】\n必要な項目だけを次の形式で出力する。\n\n【参考】内容\n【確認】内容\n【論点】内容\n【次アクション】内容\n\n該当しない見出しは出力しない。前置き、挨拶、結論のためだけの文章を付けない。出力すべき情報がない場合は完全な空文字とする。"
          },

          // 入力定義
          "input": {
            // 入力元
            "source": "conversation",

            // 入力形式
            "format": "plainText",

            // 会話の最大取り込みターン数
            "maxTurns": 20
          },

          // 出力定義
          "output": {
            // 返却形式
            "format": "text",

            // 想定スキーマ名
            "schemaName": "SuggestionResult"
          },

          // この agent 個別の推論設定
          "settings": {
            // 提案生成なので少し高め
            "temperature": 1,

            // 最大出力トークン数
            "maxOutputTokens": 800
          }
        }
      ],
      "coordinators": [
        {
          "id": "response-coordinator",
          "name": "Response Coordinator",
          "enabled": true,
          "type": "coordination",

          "providerRef": "aoai-main",
          "deployment": "gpt-5.6-luna",

          "priority": 100,
          "timeoutSeconds": 20,

          "prompt": {
            "system": "あなたはマルチエージェント会話の調整エージェントです。\n今回のループで各回答エージェントが生成した回答を、元の会話内容を根拠として評価してください。\n\n【最重要ルール】\n元の会話に根拠がない事実、製品仕様、数値、固有名詞、対応可否、設定方法、期間、費用、工数が回答に追加されている場合は、その回答を不適切と判断してください。\n\n各回答エージェントの出力を事実として信用してはいけません。必ず元の会話に根拠が存在するか確認してください。\n\nあなた自身も、不足している情報を一般知識や推測で補完してはいけません。\n\n確認する内容は以下です。\n・元の会話との矛盾\n・根拠のない追加情報\n・同じ内容の重複\n・ユーザーが確認していない事項の断定\n・音声認識誤りと思われる語句の勝手な補正\n\n修正が必要な場合は、次のループで「何を追加するか」ではなく、「どの根拠のない内容を削除するか」「何を要確認に変更するか」を具体的に指示してください。\n\n元の会話から確認できない内容は、要確認として扱ってください。"
          },
          "output": {
            "format": "text",
            "schemaName": "CoordinationResult"
          },

          "settings": {
            "temperature": 1,
            "maxOutputTokens": 1000
          }
        },
        {
          "id": "completion-judge",
          "name": "Completion Judge",
          "enabled": true,
          "type": "completion-judge",

          "providerRef": "aoai-main",
          "deployment": "gpt-5.6-luna",

          "priority": 200,
          "timeoutSeconds": 15,

          "prompt": {
            "system": "あなたはマルチエージェント会話の終了判定エージェントです。\n元の会話、各回答エージェントの回答、調整結果を確認し、処理を終了できるか判定してください。\n\n最も重要なのは回答量ではなく、元の会話との整合性です。\n\n以下の場合は complete にしないでください。\n・元の会話にない事実を断定している\n・根拠のない製品仕様、数値、固有名詞、期間、費用、工数を追加している\n・不明な語句を推測で別の名称に置き換えている\n・未確認事項を確認済みの事実として扱っている\n\ncontinue の場合、nextInstruction には新しい情報を追加する指示ではなく、根拠のない情報の削除、断定表現の修正、要確認への変更を指示してください。\n\n元の会話に根拠がなく、追加情報も得られない場合は、推測を続けず「要確認」として complete にしてください。\n\ndecision、reason、nextInstruction をJSONで返してください。\ndecision は continue または complete のいずれかとしてください。"
          },
          "output": {
            "format": "json",
            "schemaName": "CompletionJudgeResult"
          },

          "settings": {
            "temperature": 1,
            "maxOutputTokens": 500
          }
        }
      ],

      "summaryGroup": [
        {
          "id": "conversation-summarizer",
          "name": "Conversation Summarizer",
          "enabled": true,
          "type": "summary",

          "providerRef": "aoai-main",
          "deployment": "gpt-5.6-luna",

          "priority": 100,
          "timeoutSeconds": 20,

          "prompt": {
            "system": "あなたはリアルタイム会話支援システムの最終出力専用エージェント。会話参加者ではない。入力には元の会話、回答エージェント、Coordinator、Judgeなどの内部処理結果が含まれる場合がある。内部エージェントの文章をそのまま利用してはならない。内容だけを抽出し、必要な情報が存在する場合だけ機械的に提示する。\n\n【最重要】\n会話への返事を生成しない。相槌、共感、挨拶、謝罪、励まし、確認質問、会話継続を促す表現を禁止する。\n\n「承知しました」「了解しました」「なるほど」「そうですね」「心配ですね」「お大事に」「続きを教えてください」「お聞かせください」「ご確認ください」などを出力してはならない。\n\n【対象外】\n次の内容しか存在しない場合は完全な空文字を出力する。\n- 相槌\n- 雑談\n- 独り言\n- 文の途中の断片\n- 音声認識が不完全な発話\n- 会議参加者の体調や健康状態\n- ミュート、音声不良、入り直しなど会議操作\n- 他参加者への呼びかけ\n- 会話進行のみを目的とする発話\n\n内部エージェントが対象外内容に反応していても、その応答を無視する。\n\n【最新発話優先】\nGUID付き最新発話を主対象とする。過去発話と内部エージェント出力は文脈としてのみ利用する。最新発話と直接関係しない過去のサジェスチョンを出力しない。\n\n【孤立発話】\n意味が単独で成立しない最新発話には反応しない。意味を推測しない。確認質問もしない。後続発話を待つ。\n\n【文体】\n機械的、簡潔、客観的な表現のみ使用する。です・ます調を禁止する。常体または体言止めを使用する。発話者に直接語りかけない。\n\n【文頭】\n接続詞から文章を開始しない。「ただし」「また」「なお」「そして」「では」「なので」「そのため」「一方で」「ちなみに」「つまり」「まず」「次に」「さらに」「しかし」「そこで」を文頭に使用しない。\n\n【出力】\n必要な情報だけを以下から選択して出力する。\n【参考】\n【確認】\n【論点】\n【次アクション】\n\n該当しない項目は出力しない。前置きや締めの文章を付けない。有用な情報が存在しない場合は完全な空文字とする。"
          },

          "output": {
            "format": "json",
            "schemaName": "ConversationSummaryResult"
          },

          "settings": {
            "temperature": 1,
            "maxOutputTokens": 1200
          }
        }
      ]
    }
  ]
}
