{
  // 設定ファイルのバージョン
  "version": "0.1",

  // サービス全体の基本設定
  "service": {
    // サービス名
    "name": "ConversationSuggestionService",

    // 既定ロケール
    "defaultLocale": "ja-JP",

    // agent 個別に timeoutSeconds が未指定の場合の既定値
    "defaultTimeoutSeconds": 30
  },

  // LLM 接続先の定義一覧 ChatClient生成用
  "providers": [
    {
      // provider の識別子
      // agents[].providerRef から参照する
      // この設定例では、同じ Azure OpenAI resource でも複数の Microsoft Foundry を定義して、agent ごとに使い分けることが可能
      "id": "aoai-main",

      // 接続先種別
      "type": "AzureOpenAI",

      // Azure OpenAI の resource endpoint
      "endpoint": "https://agftutorial-resource.openai.azure.com/openai/v1",
      "providerName": "ssmsendpoint",
      "projectName": "firstProject",

      // 認証設定
      "authentication": {
        // 認証方式
        // 例: AccessToken / ApiKey AccessTokenは未実装
        "type": "ApiKey",
        "keyName": "AZURE_OPENAI_API_KEY"
      },

      // provider 共通の既定推論設定
      // agent 側 settings で個別上書き可能
      "defaults": {
        // 既定 temperature
        "temperature": 0.2,

        // 既定最大出力トークン数
        "maxOutputTokens": 2000
      },

      // ログ送信先 endpoint todo 未使用
      "logging": "https://example.com/api/agent-log"
    },
    {
      // provider の識別子
      // agents[].providerRef から参照する
      "id": "aoai-sub",

      // 接続先種別
      "type": "AzureOpenAI",

      // Azure OpenAI の resource endpoint
      "endpoint": "https://agftutorial-resource.openai.azure.com/openai/v1",

      // 認証設定
      "authentication": {
        // 認証方式
        // 例: AccessToken / ApiKey
        "type": "ApiKey",
        "keyName": "AZURE_OPENAI_API_KEY"
      },

      // provider 共通の既定推論設定
      // agent 側 settings で個別上書き可能
      "defaults": {
        // 既定 temperature
        "temperature": 0.2,

        // 既定最大出力トークン数
        "maxOutputTokens": 2000
      },

      // ログ送信先 endpoint
      "logging": "https://example.com/api/agent-log"
    }
  ],

  // agent 実行結果の返却先定義 todo 削除予定
  "callbacks": [
    {
      // callback の識別子
      // agents[].callbackRef から参照する
      "id": "default",

      // callback 種別
      // 今は webhook を想定
      "type": "webhook",

      // 結果送信先 URL
      "url": "https://example.com/api/agent-callback",

      // 元の会話内容を callback payload に含めるか
      "includeConversation": true,

      // agentId, agentName, type などのメタ情報を含めるか
      "includeAgentMetadata": true
    }
  ],

  // サービス全体の実行方式 // 削除予定
  "execution": {
    // 実行モード
    // parallel: 並列実行
    // sequential: 順次実行
    "mode": "parallel",

    // 戻り値の返し方
    // perAgent: agent ごとに返す拡張も考えられる todo 仕様検討中 今回は未実装 "aggregated" で返却する想定
    // aggregated: 後で統合返却する
    "returnMode": "aggregated",

    // 最大並列実行数
    "maxDegreeOfParallelism": 3
  },

  // 動的生成する agent (ChatCrientの二次元リストを生成するための設定値
  // agents[].agentsGroup は、AgentGroup の配列で、AgentGroup は agent の二次元配列 AgentGroup)一覧
  "agents": [
    {
      // 一組のマルチエージェント処理分の設定値
      "id": "conversation-monitor", // Group の識別子 agentsの中で一意
      // この agent が受け取る入力の定義
      "input": {
        // 入力元
        "source": "conversation",

        // 入力形式
        "format": "plainText",

        // 会話の最大取り込みターン数
        "maxTurns": 20
      },
      "agentsGroup": [
        {
          // agent の内部識別子 agentsの中で一意
          "id": "compliance-checker",

          // 表示名
          "name": "Compliance Checker",

          // この agent を有効化するか
          "enabled": true,

          // agent 種別
          "type": "policy-check",

          // 利用する provider
          // providers[].id を参照
          "providerRef": "aoai-main",

          // 利用する Azure OpenAI deployment 名
          "deployment": "gpt-5.6-luna",

          // 結果の返却先
          // callbacks[].id を参照
          "callbackRef": "default",

          // 実行優先度
          "priority": 100,

          // この agent 個別の timeout 秒数
          "timeoutSeconds": 15,

          // Prompt 定義
          "prompt": {
            // system prompt
            "system": "あなたは会話監視エージェントです。会話文から、法令違反、ハラスメント、不適切表現、個人情報漏えい、社内規程違反の可能性を抽出してください。重大な事象のみを報告してください。"
          },


          // 出力の期待形式 todo 削除予定
          "output": {
            // 返却形式
            "format": "json",

            // 期待する出力スキーマ名
            "schemaName": "ComplianceResult"
          },

          // provider.defaults を個別上書きする設定
          "settings": {
            // 厳密判定寄りなので低め
            "temperature": 0.1,

            // 最大出力トークン数
            "maxOutputTokens": 1000
          }
        },
        {
          // agent の内部識別子
          "id": "reference-suggester",

          // 表示名
          "name": "Reference Suggester",

          // この agent を有効化するか
          "enabled": true,

          // agent 種別
          "type": "suggestion",

          // 利用する provider
          "providerRef": "aoai-main",

          // 利用する deployment 名
          "deployment": "gpt-5.6-luna",

          // 結果の返却先
          "callbackRef": "default",

          // 実行優先度
          "priority": 50,

          // この agent 個別の timeout 秒数
          "timeoutSeconds": 20,

          // Prompt 定義
          "prompt": {
            // system prompt
            "system": "あなたは会話支援エージェントです。会話内容を読み取り、参考情報、確認事項、次のアクション候補を簡潔に提案してください。"
          },

          // 入力定義
          "input": {
            // 入力元
            "source": "conversation",

            // 入力形式
            "format": "plainText",

            // 会話の最大取り込みターン数
            "maxTurns": 20
          },

          // 出力定義
          "output": {
            // 返却形式
            "format": "json",

            // 想定スキーマ名
            "schemaName": "SuggestionResult"
          },

          // この agent 個別の推論設定
          "settings": {
            // 提案生成なので少し高め
            "temperature": 0.3,

            // 最大出力トークン数
            "maxOutputTokens": 1200
          }
        }
      ]
    }
  ]
}
